{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/openkakutou/screenpack/main/schema/v1/results.schema.json",
  "title": "Screenpack screen: results",
  "description": "screens/results.json of a screenpack. See docs/format.md.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/screen"
    }
  ],
  "properties": {
    "sounds": {
      "$ref": "common.schema.json#/$defs/sounds"
    },
    "winner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "portrait": {
          "$ref": "common.schema.json#/$defs/layoutPart"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/textPart"
        }
      }
    },
    "message": {
      "$ref": "common.schema.json#/$defs/textPart"
    },
    "score": {
      "$ref": "common.schema.json#/$defs/textPart"
    },
    "menu": {
      "$ref": "common.schema.json#/$defs/menu"
    }
  },
  "unevaluatedProperties": false
}
