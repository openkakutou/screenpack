// OpenKakutou's default screenpack: the reference example of the format
// (docs/format.md) and the fallback for every screen another pack leaves out.
{
  "$schema": "https://raw.githubusercontent.com/openkakutou/screenpack/main/schema/v1/screenpack.schema.json",
  "formatVersion": 1,
  "name": "OpenKakutou",
  "author": "OpenKakutou contributors",
  "version": "1.0.0",
  "fonts": {
    "body": "fonts/NotoSans-Regular.ttf",
    "display": "fonts/NotoSans-Bold.ttf"
  },
  "textStyles": {
    "default":  { "font": "body", "size": 3.5, "color": "#f0ece4" },
    "small":    { "font": "body", "size": 2.6, "color": "#8a8798" },
    "hint":     { "font": "body", "size": 3, "color": "#a09cae", "align": "center" },
    "heading":  { "font": "display", "size": 6, "color": "#f0ece4", "align": "center", "uppercase": true,
                  "shadow": { "color": "#00000099", "offset": [0.3, 0.3] } },
    "entry":    { "font": "display", "size": 4.2, "color": "#8a8798", "align": "center" },
    "active":   { "font": "display", "size": 4.2, "color": "#f0ece4", "align": "center" },
    "disabled": { "font": "display", "size": 4.2, "color": "#4a4858", "align": "center" },
    "value":    { "font": "display", "size": 4.2, "color": "#ff5c38", "align": "right" },
    "name":     { "font": "display", "size": 5, "color": "#f0ece4", "uppercase": true,
                  "outline": { "color": "#0e0f16", "width": 0.3 } },
    "big":      { "font": "display", "size": 16, "color": "#ff5c38", "align": "center" }
  },
  "sounds": {
    "move": "sounds/move.ogg",
    "confirm": "sounds/confirm.ogg",
    "cancel": "sounds/cancel.ogg",
    "error": "sounds/error.ogg"
  },
  "music": { "file": "sounds/theme.ogg", "volume": 0.6 },
  "warningColor": "#dc3c3c"
}
