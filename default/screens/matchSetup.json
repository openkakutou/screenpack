{
  "$schema": "https://raw.githubusercontent.com/openkakutou/screenpack/main/schema/v1/matchSetup.schema.json",
  "formatVersion": 1,
  "background": [
    { "type": "image", "image": "images/background.png", "anchor": "topLeft", "size": [400, 100] },
    { "type": "image", "image": "images/grid.png", "anchor": "topLeft", "size": [400, 100], "tile": "both", "opacity": 0.6 }
  ],
  "transition": { "in": { "kind": "fade", "ms": 250 }, "out": { "kind": "fade", "ms": 150 } },
  "title": { "style": "heading", "anchor": "top", "offset": [0, 4] },
  "menu": { "anchor": "center", "spacing": 7, "style": "entry", "activeStyle": "active",
            "valueStyle": "value", "valueOffset": [30, 0], "cursor": { "type": "rect", "size": [60, 6], "color": "#ff5c3833", "radius": 1 } }
}
